# Website (Next.js + Payload CMS) address – events are read from <this>/api/events. No trailing slash.
VITE_CMS_URL=https://your-website.example.com
# Booking API address (apps/api). No trailing slash.
VITE_API_URL=https://your-booking-api.example.com
# Optional: public website address for links (terms, privacy, contact, reserved-seating events). Defaults to VITE_CMS_URL.
VITE_SITE_URL=
